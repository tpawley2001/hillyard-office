#pragma once

#include <vcl/InterimItemWindow.hxx>
#include <vcl/weld/Button.hxx>
#include <vcl/weld/Container.hxx>
#include <vcl/weld/Label.hxx>
#include <vcl/weld/Notebook.hxx>
#include <vcl/weld/customweld.hxx>
#include <com/sun/star/frame/XFrame.hpp>

#include <map>
#include <memory>
#include <vector>

namespace sfx2
{
class RecentDocsView;
}
class TemplateDefaultView;
class VclWindowEvent;

/** Office's Backstage: the full-window File view.

    Covers the whole document window (ribbon included) with a coloured rail
    on the left (Home, New, Open | Info, Save, Save As, Print, Share, Export,
    Close | Account, Options) and the chosen page on the right. Opened by
    the Tabbed UI's File tab; Esc or Back returns to the document. Layout:
    sfx/ui/backstage.ui, generated by custom/officedefaults/make_backstage.py.
*/
class Backstage final : public InterimItemWindow
{
public:
    Backstage(vcl::Window* pParent, css::uno::Reference<css::frame::XFrame> xFrame);
    virtual ~Backstage() override;
    virtual void dispose() override;

    /// Cover the frame's window and show rPage ("home", "info", ...).
    void Open(const OUString& rPage = u"home"_ustr);
    void Close();
    OUString GetCurrentPage() const;

    virtual bool PreNotify(NotifyEvent& rNEvt) override;
    virtual bool EventNotify(NotifyEvent& rNEvt) override;
    virtual void DataChanged(const DataChangedEvent& rDCEvt) override;

    /// The Backstage of xFrame's window, made on first use.
    static VclPtr<Backstage> Get(const css::uno::Reference<css::frame::XFrame>& xFrame);

private:
    css::uno::Reference<css::frame::XFrame> mxFrame;
    OUString maModule;
    Color maAccent;
    OUString maPage;
    bool mbTemplatesFilled;

    std::unique_ptr<weld::Container> mxRail;
    std::unique_ptr<weld::Button> mxBack;
    std::vector<std::pair<OUString, std::unique_ptr<weld::Button>>> maRail;
    std::unique_ptr<weld::Notebook> mxPages;
    std::map<OUString, std::unique_ptr<weld::Button>> maActions;
    std::vector<std::unique_ptr<weld::Label>> maTitles;

    std::unique_ptr<weld::Label> mxGreeting;
    std::unique_ptr<weld::Button> mxHomeBlank;
    std::unique_ptr<weld::Button> mxHomeMore;
    std::unique_ptr<weld::Button> mxNewBlank;
    std::unique_ptr<sfx2::RecentDocsView> mxHomeRecent;
    std::unique_ptr<weld::CustomWeld> mxHomeRecentWin;
    std::unique_ptr<sfx2::RecentDocsView> mxOpenRecent;
    std::unique_ptr<weld::CustomWeld> mxOpenRecentWin;
    std::unique_ptr<TemplateDefaultView> mxTemplates;
    std::unique_ptr<weld::CustomWeld> mxTemplatesWin;

    std::unique_ptr<weld::Label> mxInfoName;
    std::unique_ptr<weld::Label> mxInfoPath;
    std::map<OUString, std::unique_ptr<weld::Label>> maProps;
    std::unique_ptr<weld::Label> mxPrinter;
    std::unique_ptr<weld::Label> mxProduct;
    std::unique_ptr<weld::Label> mxVersion;

    void FitToParent();
    bool HandleEscape(const NotifyEvent& rNEvt);
    void ShowRibbon(bool bShow);
    void ApplyColors();
    void PaintRail();
    void Refresh();
    void RefreshInfo();
    void SelectPage(const OUString& rPage);
    void Dispatch(const OUString& rCommand);

    DECL_LINK(ParentEventHdl, VclWindowEvent&, void);
    DECL_LINK(RailHdl, weld::Button&, void);
    DECL_LINK(ActionHdl, weld::Button&, void);
    DECL_LINK(BackHdl, weld::Button&, void);
    DECL_LINK(BlankHdl, weld::Button&, void);
    DECL_LINK(MoreHdl, weld::Button&, void);
    DECL_LINK(OpenTemplateHdl, const OUString&, void);
};

