	<!-- Alias similar/metric-compatible families from various sources: -->

	<alias binding="same">
	  <family>Liberation Sans Narrow</family>
	  <default>
	  <family>Arial Narrow</family>
	  </default>
	</alias>

	<alias binding="same">
	  <family>Arial Narrow</family>
	  <accept>
	  <family>Liberation Sans Narrow</family>
	  </accept>
	</alias>

	<!-- Hillyard Office: fonts that ship with Microsoft Office or Windows.
	     The Hillyard families (extras/source/truetype/hillyard) have the
	     Office font's widths and, after custom/fonts/build_metric_fonts.py,
	     its line height too. The rest are the closest bundled face by measured
	     width on typical text: Liberation Sans is 99.8% of Tahoma and 98.2% of
	     Trebuchet MS, DejaVu Sans 99.1% of Verdana, Carlito 101.1% of Calibri
	     Light and 95.8% of Franklin Gothic Book. -->
	<alias binding="same">
	  <family>Century Gothic</family>
	  <accept>
	  <family>Hillyard Gothic</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Book Antiqua</family>
	  <accept>
	  <family>Hillyard Antiqua</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Palatino Linotype</family>
	  <accept>
	  <family>Hillyard Palatino</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Bookman Old Style</family>
	  <accept>
	  <family>Hillyard Bookman</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Century Schoolbook</family>
	  <accept>
	  <family>Hillyard Schoolbook</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Georgia</family>
	  <accept>
	  <family>Hillyard Serif</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Segoe UI</family>
	  <accept>
	  <family>Hillyard Sans UI</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Segoe UI Light</family>
	  <accept>
	  <family>Hillyard Sans UI Light</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Segoe UI Semilight</family>
	  <accept>
	  <family>Hillyard Sans UI Semilight</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Segoe UI Semibold</family>
	  <accept>
	  <family>Hillyard Sans UI Semibold</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Calibri Light</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Tahoma</family>
	  <accept>
	  <family>Liberation Sans</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Verdana</family>
	  <accept>
	  <family>DejaVu Sans</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Trebuchet MS</family>
	  <accept>
	  <family>Liberation Sans</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Franklin Gothic Book</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<!-- Aptos is Office's default font since 2023 and has no metric-compatible
	     free clone. These are the closest bundled faces by measured advance
	     widths on typical document text: Carlito 94.6% of Aptos (Display 100.1%,
	     Narrow 102.7%), Caladea 94.7% of Aptos Serif, Liberation Mono 100% of
	     Aptos Mono. Slightly narrow is preferred over wide so text never
	     overflows a fixed box. Without these, fontconfig picks DejaVu Sans,
	     117.7% of Aptos's width. -->
	<alias binding="same">
	  <family>Aptos</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Display</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Narrow</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Light</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos SemiBold</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos ExtraBold</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Black</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Serif</family>
	  <accept>
	  <family>Caladea</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Aptos Mono</family>
	  <accept>
	  <family>Liberation Mono</family>
	  </accept>
	</alias>

	<!-- Helvetica Neue is the default in PowerPoint and Keynote templates made on
	     macOS and is never available elsewhere. Without this, fontconfig falls
	     through to DejaVu Sans, which is much wider, and titles wrap onto extra
	     lines. Liberation Sans shares Helvetica's metrics and is the closest
	     bundled face; it is not metric-compatible with Helvetica Neue itself. -->
	<alias binding="same">
	  <family>Helvetica Neue</family>
	  <accept>
	  <family>Liberation Sans</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Calibri</family>
	  <accept>
	  <family>Carlito</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Cambria</family>
	  <accept>
	  <family>Caladea</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Agency FB</family>
	  <accept>
	  <family>Agdasima</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Baskerville Old Face</family>
	  <accept>
	  <family>Bacasime Antique</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Berlin Sans FB</family>
	  <accept>
	  <family>Belanosima</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Cooper Black</family>
	  <accept>
	  <family>Caprasimo</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Lucida Grande</family>
	  <accept>
	  <family>Lunasima</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Lucida Handwriting</family>
	  <accept>
	  <family>Lumanosimo</family>
	  </accept>
	</alias>

	<alias binding="same">
	  <family>Lucida Calligraphy</family>
	  <accept>
	  <family>Lugrasimo</family>
	  </accept>
	</alias>
