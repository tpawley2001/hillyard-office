        <!-- Ctrl+Shift+F5 bookmark -->
        <node oor:name="F5_SHIFT_MOD1" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:InsertBookmark</value>
          </prop>
