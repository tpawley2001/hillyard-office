          </prop>
        </node>
        <!-- Ctrl+Alt+- em dash -->
        <node oor:name="SUBTRACT_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:InsertText?Text:string=—</value>
          </prop>
        </node>
        <!-- Ctrl+Alt+C copyright sign -->
        <node oor:name="C_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
