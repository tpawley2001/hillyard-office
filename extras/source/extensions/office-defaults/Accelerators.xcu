        <node oor:name="EQUAL_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:InsertObjectStarMath</value>
          </prop>
        </node>
        <!-- Ctrl+Q remove paragraph formatting (not Exit) -->
        <node oor:name="Q_MOD1" oor:op="replace">
