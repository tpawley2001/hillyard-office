          </prop>
        </node>
        <!-- Ctrl+Alt+R registered sign -->
        <node oor:name="R_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:InsertText?Text:string=®</value>
          </prop>
        </node>
        <!-- Ctrl+Alt+T trademark sign -->
        <node oor:name="T_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:InsertText?Text:string=™</value>
