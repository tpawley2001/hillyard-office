          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:Grow</value>
          </prop>
        </node>
        <!-- Ctrl+Shift+> grow font -->
        <node oor:name="GREATER_SHIFT_MOD1" oor:op="replace">
          <prop oor:name="Command">
            <value xml:lang="en-US">.uno:Grow</value>
          </prop>
