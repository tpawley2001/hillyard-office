 *
 * Hillyard Office: no Tip of the Day dialog at start-up; Office has none.
 * Macro recording on, so Word's View > Macros > Record Macro is there.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
    <prop oor:name="ShowTipOfTheDay">
      <value>false</value>
    </prop>
    <prop oor:name="MacroRecorderMode">
      <value>true</value>
    </prop>
  </node>
</oor:component-data>
