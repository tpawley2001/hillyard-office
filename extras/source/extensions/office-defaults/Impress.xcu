 *
 * Hillyard Office: a new presentation opens on a blank title slide, as in
 * PowerPoint, instead of the template picker.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Impress" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
    <node oor:name="NewDoc">
      <prop oor:name="AutoPilot">
        <value>false</value>
      </prop>
    </node>
  </node>
</oor:component-data>
