# Hillyard Office: the templates File > New starts from, so a new document
# gets Word's Normal template, a new workbook Excel's defaults and a new
# presentation PowerPoint's Blank Presentation (set as
# ooSetupFactoryTemplateFile by the Office Defaults extension,
# Package_officedefaults_ext.mk). Generated by
# custom/officedefaults/make_templates.py.

$(eval $(call gb_Package_Package,extras_officedefaults,$(SRCDIR)/extras/source/officedefaults))

$(eval $(call gb_Package_add_files_with_dir,extras_officedefaults,$(LIBO_SHARE_FOLDER)/officedefaults,\
	Book.xltx \
	Normal.dotx \
	Presentation.potx \
))

