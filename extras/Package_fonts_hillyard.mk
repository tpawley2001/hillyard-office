#
# Hillyard metric-compatible fonts: free fonts with the widths and line height
# of fonts that ship with Microsoft Office and Windows. Generated by
# custom/fonts/build_metric_fonts.py; licences and manifest are beside them.

$(eval $(call gb_Package_Package,extras_fonts_hillyard,$(SRCDIR)/extras/source/truetype/hillyard))

$(eval $(call gb_Package_add_files,extras_fonts_hillyard,$(LIBO_SHARE_FOLDER)/fonts/truetype,\
	$(notdir $(wildcard $(SRCDIR)/extras/source/truetype/hillyard/*.otf)) \
	$(notdir $(wildcard $(SRCDIR)/extras/source/truetype/hillyard/*.ttf)) \
))

$(eval $(call gb_Package_add_files,extras_fonts_hillyard,$(LIBO_SHARE_FOLDER)/fonts/truetype/hillyard-licenses,\
	LICENSE-gelasio.txt \
	LICENSE-selawik.txt \
	LICENSE-texgyre.txt \
	LICENSE-urw.txt \
	LICENSE-urw-COPYING.txt \
	MANIFEST-hillyard.txt \
))

